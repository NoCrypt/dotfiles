// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "format_on_save": "modifications",
  "languages": {
    "Rust": {
      "prettier": {
        "allowed": true
      }
    }
  },
  "middle_click_paste": false,
  "minimap": {
    "show": "auto"
  },
  "buffer_line_height": "comfortable",
  "icon_theme": "Colored Zed Icons Theme Dark",
  "markdown_preview": {
    "open_markdown_files_in_preview": false,
    "max_width": 1200.0,
    "limit_content_width": true,
    "heading_font_weight": 700.0,
    "font_family": "Google Sans Flex Static"
  },
  "cli_default_open_behavior": "existing_window",
  "tab_size": 4,
  "collaboration_panel": {
    "button": false
  },
  "git_panel": {
    "dock": "left"
  },
  "agent": {
    "thinking_display": "preview",
    "threads_sidebar": {
      "position": "right"
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "project_panel": {
    "dock": "left"
  },
  "edit_predictions": {
    "allow_data_collection": "no",
    "provider": "none"
  },
  "agent_servers": {
    "opencode-v2": {
      "default_config_options": {
        "model": "deepseek/deepseek-flash"
      },
      "type": "registry"
    }
  },
  "agent_ui_font_size": 18.0,
  "agent_buffer_font_size": 16.0,
  "ui_font_weight": 400.0,
  "ui_font_family": "Google Sans Flex Static",
  "terminal": {
    "font_size": 18.0
  },
  "mouse_wheel_zoom": true,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "session": {
    "trust_all_worktrees": true
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
    "anthropic_retention": false
  },
  "base_keymap": "VSCode",
  "ui_font_size": 18.0,
  "buffer_font_size": 15.0,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "GitHub Dark Transparent",
  },
  "lsp": {
      "rust-analyzer": {
        "initialization_options": {
          // 1. Prevent heavy background spikes on project startup
          "cachePriming": {
            "enable": false
          },
          // 2. Reduce real-time Cargo check lag (runs check only on manual save)
          "checkOnSave": true,
          // 3. Skip heavy clippy/check documentation indexing if unnecessary
          "hover": {
            "documentation": {
              "enable": true
            }
          },
          // 4. Opt-out of proc-macro expansion if your macros are heavily bottlenecking
          "procMacro": {
            "enable": true
          },
          // 5. Restrict diagnostic calculations to the current active file
          "diagnostics": {
            "experimental": {
              "enable": false
            }
          }
        }
      }
    }
}
