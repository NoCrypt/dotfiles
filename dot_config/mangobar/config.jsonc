// mangobar config (JSONC).
{
    "layer": "top",
    "height": 30,
    "buffer-scale": 1,
    // "scroll-interval": 100,
    // "smooth-scrolling-threshold": 5.0,

    "modules-left": [
        "custom/applist",
	"workspaces",
        "layout",
        "window"
    ],
    "modules-center": [
	"clock#date",
	"clock#time"
    ],

    "modules-right": [
        "hideclients",
        "custom/record",
        "tray",
        "network",
	"pulseaudio",
        // "keymode",
        // "keyboardlayout",
        "cpu",
        "custom/memory",
        //"pulseaudio",
        "custom/brightness",
        "battery",
        "custom/caffeine",
        "custom/power"
    ],

    "workspaces": {
        "hide-empty": true,
//	"persistent-only": true,
//	"persistent-workspaces": {
//	    "*": [1, 2, 3, 4]
//	},
        // "pinned": [1, 2],
        "tag-names": ["\uf120", "\uf0ac", "\uf086", "4", "5", "6", "7", "8", "9"],
        "overview-label": "OVERVIEW",
        "on-click": "activate",
        "on-click-right": "toggle",
        "scroll-interval": 100,
        "on-scroll-up": "mmsg dispatch viewtoleft_have_client",
        "on-scroll-down": "mmsg dispatch viewtoright_have_client"
    },
    "layout": {
        "format": "{}"
    },
    "window": {
        "format": "{}",
        "on-click": "bash /home/ncpt/.config/mango/scripts/screenshot.sh",
        "on-click-right": "bash /home/ncpt/.config/mango/scripts/ocr.sh",
	"max-length": 500
    },

    // left click cycles to the traffic format-alt, right click opens nmtui
    "network": {
        //"format": "󰈀 {ifname}",
        //"format-alt": "↓{down} ↑{up}"
	"format": " ",
	"format-wifi": "{icon} {signal} {ssid}",
	"format-alt": "↓{down} ↑{up}",
	"format-ethernet": "󰈀 ",
	"format-disconnected": " ",
	"icon-wifi": "󰖩",
	"icon-ethernet": "󰈀",
	"icon-disconnected": "󰖪",
	"signal-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
	"on-click-right": "kitty --class nmtui -e nmtui"
    },
    "hideclients": {
        "format": " {}"
    },
    "cpu": {
        "format": " {usage}%",
	"on-click": "foot -e gotop"
    },
    "custom/memory": {
        "format": " {usage}",
        "exec": "/home/ncpt/.config/mango/scripts/memory.sh",
        "interval": 5,
        "on-click": "foot -e gotop"
    },
    "pulseaudio": {
        "format": "{icon} {volume}% {bt}",
        "format-muted": "󰖁 {volume}% {bt}",
        "icons": ["󰕿", "󰖀", "󰕾"],
        // "icon-bluetooth": "󰂯",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "on-click-right": "pwvucontrol"
    },
    "battery": {
        "format": "{icon} {percent}% {ac}",
        "icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "icon-charging": "󰂄",
        "icon-full": "󰁹",
        "icon-ac": "",
        "hide-on-ac": true
    },
    "clock#date": {
        "format": "{:L%A %d %b}"
    },
    "clock#time": {
        "format": "{:L%H:%M}"
    },
    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    "custom/record": {
        "format": "{}",
        "exec": "/home/ncpt/.config/mango/scripts/record.sh status",
        "interval": 30,
        "signal": 8,
        "on-click": "/home/ncpt/.config/mango/scripts/record.sh toggle"
    },

    "custom/power": {
        "format": "",
        "on-click": "GDK_BACKEND=wayland wlogout -C /home/ncpt/.config/mango/wlogout/style.css -l /home/ncpt/.config/mango/wlogout/layout -b 6 --protocol layer-shell"
    },

    "custom/applist": {
	"format": "󰀻",
	"on-click": "fuzzel"
    },

    "custom/caffeine": {
        "format": "{}",
        "exec": "/home/ncpt/.config/mango/scripts/caffeine.sh show",
        "interval": 30,
        "signal": 9,          // caffeine.sh sends SIGRTMIN+9 after a toggle
        "on-click": "/home/ncpt/.config/mango/scripts/caffeine.sh toggle"
    },

    // brightness of the screen the knob is controlling (panel or external)
    "custom/brightness": {
        "format": "{}",
        "exec": "/home/ncpt/.config/mango/scripts/knob.sh show",
        "interval": 30,
        "signal": 8,          // knob.sh sends SIGRTMIN+8 after every change
        "on-click": "/home/ncpt/.config/mango/scripts/knob.sh screen",
        "on-scroll-up": "/home/ncpt/.config/mango/scripts/knob.sh up",
        "on-scroll-down": "/home/ncpt/.config/mango/scripts/knob.sh down"
    }
}
