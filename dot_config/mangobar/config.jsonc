// mangobar config (JSONC).
{
    "layer": "top",
    "height": 30,
    "buffer-scale": 1,
    // "scroll-interval": 100,
    // "smooth-scrolling-threshold": 5.0,

    "modules-left": [
        "custom/applist",
	"workspaces",
        "layout",
        "window"
    ],
    "modules-center": [
	"clock#date",
	"clock#time"
    ],

    "modules-right": [
        "hideclients",
        "tray",
        "network",
	"pulseaudio",
        // "keymode",
        // "keyboardlayout",
        "cpu",
        "memory",
        //"pulseaudio",
        "custom/brightness",
        "battery",
        "custom/power"
    ],

    "workspaces": {
        "hide-empty": true,
//	"persistent-only": true,
//	"persistent-workspaces": {
//	    "*": [1, 2, 3, 4]
//	},
        // "pinned": [1, 2],
        // "tag-names": ["1", "2", "3", "编", "网"],
        "overview-label": "OVERVIEW",
        "on-click": "activate",
        "on-click-right": "toggle"
    },
    "layout": {
        "format": "{}"
    },
    "window": {
        "format": "{}",
        "on-click": "grim ~/Pictures/Screenshots/$(date +%Y-%m-%d_%H_%M_%S).png",
        "on-click-right": "python /home/wrq/tool/ocr.py",
	"max-length": 500
    },

    "network": {
        //"format": "󰈀 {ifname}",
        //"format-alt": "↓{down} ↑{up}"
	"format": " ",
	"format-wifi": " ",
	"format-ethernet": "󰈀 ",
	"format-disconnected": " ",
	"on-click": "networkmanager_dmenu"
    },
    "hideclients": {
        "format": " {}"
    },
    "cpu": {
        "format": " {load}%",
	"on-click": "foot -e gotop"
    },
    "memory": {
        "format": " {}%",
	"on-click": "foot -e gotop"
    },
    "pulseaudio": {
        "format": "{icon} {volume}% {bt}",
        "format-muted": "󰖁 {volume}% {bt}",
        "icons": ["󰕿", "󰖀", "󰕾"],
        // "icon-bluetooth": "󰂯",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "battery": {
        "format": "{icon} {percent}% {ac}",
        "icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "icon-charging": "󰂄",
        "icon-full": "󰁹",
        "icon-ac": "",
        "hide-on-ac": true
    },
    "clock#date": {
        "format": "{:L%A %d %b}"
    },
    "clock#time": {
        "format": "{:L%H:%M}"
    },
    "tray": {
        "icon-size": 25,
        "spacing": 10
    },

    "custom/power": {
        "format": "",
        "on-click": "GDK_BACKEND=wayland wlogout -C /home/ncpt/.config/mango/wlogout/style.css -l /home/ncpt/.config/mango/wlogout/layout -b 6 --protocol layer-shell"
    },

    "custom/applist": {
	"format": "󰀻",
	"on-click": "fuzzel"
    },

    // brightness of the screen the knob is controlling (panel or external)
    "custom/brightness": {
        "format": "{}",
        "exec": "/home/ncpt/.config/mango/scripts/knob.sh show",
        "interval": 30,
        "signal": 8,          // knob.sh sends SIGRTMIN+8 after every change
        "on-click": "/home/ncpt/.config/mango/scripts/knob.sh screen",
        "on-scroll-up": "/home/ncpt/.config/mango/scripts/knob.sh up",
        "on-scroll-down": "/home/ncpt/.config/mango/scripts/knob.sh down"
    }
}
